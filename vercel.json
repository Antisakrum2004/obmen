{
  "rewrites": [
    { "source": "/", "destination": "/payroll.html" },
    { "source": "/api/bx/:method", "destination": "/api/bx-proxy.js?method=:method" }
  ],
  "headers": [
    {
      "source": "/payroll.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
